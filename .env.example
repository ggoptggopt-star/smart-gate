# ============================================================================
# SMART GATE ENVIRONMENT VARIABLES (.env)
# คัดลอกไฟล์นี้เป็น .env เพื่อใช้งาน
# ============================================================================

PORT=3000

# Supabase Credentials (หากยังไม่ได้กรอก ระบบจะทำงานในโหมด Demo Memory อัตโนมัติ)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# HiveMQ Cloud MQTT (สำหรับสั่งบอร์ด ESP32 ข้ามเน็ต)
MQTT_BROKER=your-cluster-url.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_TOPIC_COMMAND=school/gate/cmd
MQTT_TOPIC_STATUS=school/gate/status
